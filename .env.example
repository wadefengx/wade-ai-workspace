# Docker Compose configuration. Copy this file to .env before first startup.
# Keep MONGO_DATABASE unchanged to use the existing local workspace data.

# Host ports. Change only when the default port is already occupied.
WEB_PORT=3000
API_PORT=3001
MONGO_PORT=27017

# MongoDB database name. Changing this selects a different (initially empty) database.
MONGO_DATABASE=wade_workspace

# Required: replace before sharing the environment or deploying beyond local development.
JWT_SECRET=replace-with-a-long-random-secret

# Ollama model names downloaded by Docker Compose on first startup.
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Maximum uploaded file size accepted by the API.
MAX_UPLOAD_SIZE_MB=10
